{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pri:schema:promotion:v0.1",
  "title": "PRI Promotion",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "pri/v0.1"
    },
    "kind": {
      "const": "Promotion"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": ["unit", "artifacts", "targets"],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/identifier"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "description": "PRI keeps metadata open so implementations can preserve runtime-populated metadata without failing validation.",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "policyRef": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/identifierList"
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["ref", "mode"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/identifier"
        },
        "mode": {
          "type": "string",
          "enum": ["push", "pull", "manual"]
        },
        "parameters": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["name", "type", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": ["verification", "approval", "test", "scan", "audit", "other"]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "identifierList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9=_+./-]+$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
