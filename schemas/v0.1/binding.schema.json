{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pri:schema:binding:v0.1",
  "title": "PRI Binding",
  "description": "Machine-readable summary of a PRI binding. Binding documents are optional and do not make a binding mandatory for core PRI conformance.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "pri/v0.1"
    },
    "kind": {
      "const": "Binding"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": ["category", "priVersions", "adoptionModes", "roundTrip"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["platform", "event", "evidence", "artifact", "storage"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "priVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+$"
          }
        },
        "adoptionModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["native", "emission", "bridge"]
          }
        },
        "roundTrip": {
          "type": "string",
          "enum": ["lossless", "lossy", "emission-only"]
        },
        "mappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mapping"
              }
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mapping"
              }
            }
          }
        },
        "requiredConfiguration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configuration"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["pri", "external"],
      "additionalProperties": false,
      "properties": {
        "pri": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["title", "uri"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
