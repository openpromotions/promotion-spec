{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pri:schema:evidence:v0.1",
  "title": "PRI Evidence",
  "description": "Standalone Evidence document. Its metadata.name maps to inline Promotion.spec.evidence[].name; spec.type, spec.uri, and spec.digest map to the corresponding inline Evidence fields.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "pri/v0.1"
    },
    "kind": {
      "const": "Evidence"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": ["type", "uri"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["verification", "approval", "test", "scan", "audit", "other"]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "subjectRefs": {
          "$ref": "#/$defs/identifierList"
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "identifierList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9=_+./-]+$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
